// Tributary — formal specification of the security-critical pull-payment
// logic. Audit-first (bean tributary-eu41): the program's drain-resistance
// and fee-conservation logic already lives in PURE functions
// (`shared::schedule::validate_policy_execution`, `advance_policy`,
// `shared::fees::calculate_fees`). This spec captures those contracts as
// the single source of truth and declares the headline preservation
// properties the execute handlers must satisfy.
//
// IN SCOPE (provable here):
//   - Pull-amount bounds for PayAsYouGo (chunk cap) and Milestone
//     (signer-bit access control). Subscription / OneTime / UpTo pull
//     bounds are DEFERRED — see bean tributary-eu41 §S3.
//   - PAYG cross-period drain-resistance (A2): no chunk sequence, across
//     period resets, extracts more than `max_amount_per_period` per period.
//   - Fee conservation: carve-outs sum to `total_fee`, residual >= 0, no
//     overflow for ALL inputs (both referral-enabled and disabled).
//     Composable reuses `calculate_fees`, so its sweep conservation is
//     the SAME property.
//   - Gross-mode recipient guarantee (recipient_net_of_fee): scoped to
//     `is_net_mode == 0` via requires on execute handlers.
//   - Access control: milestone release_condition signer-bit authorization.
//
// OUT OF SCOPE (integration-tested only — see Honest Claim in README):
//   account wiring / PDA derivation, forward-program allowlist (Meteora),
//   signer sanitization (ADR-0008), emergency-pause wiring, admin/config
//   handlers, post_validation assertions (Lighthouse). Swap-output
//   conservation is Meteora DLMM's responsibility. `delegated_amount` is
//   SPL Token program state (read-only here).

spec Tributary
program_id "TRibg8W8zmPHQqWtyAD1rEBRXEdyU13Mu6qX1Sg42tJ"

// Route checked-arithmetic overflow (DSL default for += / -=) to the real
// TributaryError variant. The generated Rust references this on overflow.
pragma checked_overflow_error = ArithmeticOverflow

// Flat verification state — the security-relevant scalar fields drawn from
// PolicyType (PAYG branch), the fee model (ADR-0018), and policy status.
// Multi-variant PolicyType is intentionally collapsed: the headline proofs
// are field-wise preservation obligations, which the flat form discharges
// automatically. Variant-specific guards live in `requires`.
type State = {
  // Lifecycle
  policy_status          : U8,   // 0 = Active, 1 = Completed, 2 = Paused
  emergency_pause        : U8,   // global pause (ProgramConfig)

  // PayAsYouGo period envelope (the A2 target)
  max_amount_per_period  : U64,
  max_chunk_amount       : U64,
  period_length_seconds  : U64,
  current_period_start   : U64,  // model i64 as U64; relative ordering preserved
  current_period_total   : U64,

  // Pull amount actually settled this call (for pull_bounded)
  pulled_amount          : U64,

  // Unified fee model inputs (ADR-0018)
  payment_amount         : U64,  // gross pull basis
  gateway_fee_bps        : U16,
  protocol_share_bps     : U16,
  scheduler_share_bps    : U16,
  referral_allocation_bps: U16,
  is_referral_enabled    : U8,   // 0/1
  is_net_mode            : U8,   // 0/1

  // Fee breakdown outputs (calculate_fees)
  total_fee              : U64,
  protocol_cut           : U64,
  scheduler_cut          : U64,
  referral_pool          : U64,
  gateway_residual       : U64,
  recipient_amount       : U64,
  total_from_user        : U64,

  // Milestone release_condition (RELEASE_* bitmap, modeled as 4 booleans
  // since the DSL has no bitwise ops; the bitmap is just a compact encoding
  // of mutually-exclusive signer flags — bit0 due-date, bits1-3 exclusive).
  release_due_date       : U8,   // bit0 RELEASE_DUE_DATE set (0b0001)
  release_requires_gateway : U8,  // bit1 RELEASE_GATEWAY set
  release_requires_owner  : U8,   // bit2 RELEASE_OWNER set
  release_requires_recipient : U8,// bit3 RELEASE_RECIPIENT set
  caller_is_gateway      : U8,   // caller == gateway_signer
  caller_is_owner        : U8,   // caller == owner
  caller_is_recipient    : U8,   // caller == recipient
}

type Error
  | ProgramPaused
  | InvalidAmount
  | Unauthorized
  | PaymentNotDue
  | PolicyExpired
  | ArithmeticOverflow
  | InsufficientDelegatedAmount
  | PolicyPaused
  | CombinedFeeBpsExceedsMax

const BPS_DENOMINATOR = 10000

// bps_mul(amount, bps) = amount * bps / 10000  (floor; matches shared::fees::bps_mul)
ref_impl bps_mul (amount : U64) (bps : U16) : U64 =
  mul_div_floor(amount, bps, BPS_DENOMINATOR)

// ── create_payment_policy ───────────────────────────────────────────
// Establishes the PAYG envelope bounds. The period invariant holds
// trivially at creation (current_period_total = 0 <= max_amount_per_period),
// so this handler ESTABLISHES period_bounded rather than preserving it.
handler create_payment_policy
    (max_per_period : U64) (max_chunk : U64) (period_secs : U64) (fee_bps : U16)
    (proto_share : U16) (sched_share : U16) (referral_share : U16)
    : State -> State {
  permissionless
  requires max_per_period > 0 else InvalidAmount
  requires max_chunk > 0 else InvalidAmount
  requires max_chunk <= max_per_period else InvalidAmount
  requires period_secs > 0 else InvalidAmount
  // ADR-0018: protocol + scheduler + referral shares must sum to <= 10000 bps.
  requires (proto_share + sched_share + referral_share) <= BPS_DENOMINATOR
    else CombinedFeeBpsExceedsMax

  effect {
    policy_status           := 0            // Active
    max_amount_per_period   := max_per_period
    max_chunk_amount        := max_chunk
    period_length_seconds   := period_secs
    current_period_total    := 0
    current_period_start    := 0
    gateway_fee_bps         := fee_bps
    protocol_share_bps      := proto_share
    scheduler_share_bps     := sched_share
    referral_allocation_bps := referral_share
    // Initialize fee outputs + pull accumulator to a consistent zero state
    // so every property holds at creation (establishes, below).
    pulled_amount           := 0
    payment_amount          := 0
    total_fee               := 0
    protocol_cut            := 0
    scheduler_cut           := 0
    referral_pool           := 0
    gateway_residual        := 0
    recipient_amount        := 0
    total_from_user         := 0
  }
  establishes period_bounded
  establishes fee_conservation
  establishes fee_is_bps_decomposition
  establishes recipient_net_of_fee
  establishes pull_bounded
  establishes residual_nonnegative
}

// ── execute_payment (PAYG branch) ───────────────────────────────────
// Permissionless (ADR-0004): any gateway signer may trigger. Models
// validate_policy_execution (PAYG) -> calculate_fees -> advance_policy.
// Split on period rollover: each arm is its own preservation case for A2.
handler execute_payment (chunk : U64) (current_time : U64) : State -> State {
  permissionless
  requires emergency_pause == 0 else ProgramPaused
  requires policy_status == 0 else PolicyPaused
  // validate_policy_execution — PAYG chunk bounds
  requires chunk > 0 else InvalidAmount
  requires chunk <= max_chunk_amount else InvalidAmount
  // recipient_net_of_fee is a gross-mode property (ADR-0018); net mode
  // satisfies recipient_amount == payment_amount (different identity, not claimed).
  requires is_net_mode == 0

  match
    // Period window elapsed AND new-period cap holds → reset.
    | current_time >= current_period_start + period_length_seconds
        and chunk <= max_amount_per_period =>
        effect {
          current_period_start := current_time
          current_period_total := chunk
          pulled_amount        := chunk
          payment_amount       := chunk
          total_fee            := bps_mul(chunk, gateway_fee_bps)
          protocol_cut         := bps_mul(total_fee, protocol_share_bps)
          scheduler_cut        := bps_mul(total_fee, scheduler_share_bps)
          referral_pool        := if is_referral_enabled == 1 then bps_mul(total_fee, referral_allocation_bps) else 0
          gateway_residual     := total_fee - protocol_cut - scheduler_cut - referral_pool
          recipient_amount     := payment_amount - total_fee
          total_from_user      := payment_amount
        }
    // Same period AND accumulation stays within cap (A2 guard).
    | current_time < current_period_start + period_length_seconds
        and chunk <= max_amount_per_period - current_period_total =>
        effect {
          current_period_total += chunk
          pulled_amount        := chunk
          payment_amount       := chunk
          total_fee            := bps_mul(chunk, gateway_fee_bps)
          protocol_cut         := bps_mul(total_fee, protocol_share_bps)
          scheduler_cut        := bps_mul(total_fee, scheduler_share_bps)
          referral_pool        := if is_referral_enabled == 1 then bps_mul(total_fee, referral_allocation_bps) else 0
          gateway_residual     := total_fee - protocol_cut - scheduler_cut - referral_pool
          recipient_amount     := payment_amount - total_fee
          total_from_user      := payment_amount
        }
    // Any accepted chunk that would breach the per-period cap is rejected.
    | _ => abort InsufficientDelegatedAmount
}

// ── execute_composable (PAYG branch, v2.2 / ADR-0026) ────────────────
// Composable fee path is INPUT-SIDE and GROSS-ON-PULL (ADR-0026):
//   - The caller passes `face` (the amount the forward consumes).
//   - Composable pulls GROSS = face + fee, where fee = bps_mul(face, gateway_fee_bps).
//   - Fee is skimmed from intermediate_input in input_mint BEFORE the forward
//     runs. PaymentPolicy still honors `is_net_mode`; composable HARDCODES it.
//   - PayAsYouGo caps bind on GROSS (both max_chunk_amount and the rolling
//     period accumulator). Delegate approval binds on GROSS too (modeled as
//     a requires here — the actual delegate check lives in the SPL Token
//     program; we mirror the boundary so the spec captures the obligation).
//   - Settlement-shape dispatch (deliver-no-transform / deliver-transform /
//     act) routes the residual but does not affect fee conservation. The
//     three shapes are exhaustive over (forward_enabled × output_mint_sentinel):
//       • forward disabled + output_mint == input_mint        → deliver-no-xform
//       • forward enabled  + output_mint set, != input_mint   → deliver-xform
//       • forward enabled  + output_mint == sentinel (default) → act mode
//     The >0 output guard is KEPT in deliver-transform mode, SKIPPED in act
//     mode (see `act_mode_skips_output_guard` documentation invariant).
//
// v2.1 (bean tributary-zvku): min_output_amount was REMOVED from the code.
// post_validation (a Lighthouse assertion) generalizes it.
// v2.2 (bean tributary-t6gt / ADR-0026): fee rebased to input-side gross
// pull. The handler model below captures the new face/gross split.
handler execute_composable (face : U64) (current_time : U64) : State -> State {
  permissionless
  requires emergency_pause == 0 else ProgramPaused
  requires policy_status == 0 else PolicyPaused
  requires face > 0 else InvalidAmount
  // NET-on-pull HARDCODED for composable (ADR-0026). is_net_mode is ignored
  // — the handler always pulls gross. We keep the field for PaymentPolicy.
  // PayAsYouGo caps bind on GROSS (face + fee), not on face alone.
  requires (face + bps_mul(face, gateway_fee_bps)) <= max_chunk_amount
    else InvalidAmount

  match
    // Period window elapsed AND new-period cap holds (on gross) → reset.
    | current_time >= current_period_start + period_length_seconds
        and (face + bps_mul(face, gateway_fee_bps)) <= max_amount_per_period =>
        effect {
          current_period_start := current_time
          current_period_total := face + bps_mul(face, gateway_fee_bps)
          pulled_amount        := face + bps_mul(face, gateway_fee_bps)
          payment_amount       := face
          total_fee            := bps_mul(face, gateway_fee_bps)
          protocol_cut         := bps_mul(total_fee, protocol_share_bps)
          scheduler_cut        := bps_mul(total_fee, scheduler_share_bps)
          referral_pool        := if is_referral_enabled == 1 then bps_mul(total_fee, referral_allocation_bps) else 0
          gateway_residual     := total_fee - protocol_cut - scheduler_cut - referral_pool
          recipient_amount     := payment_amount
          total_from_user      := face + bps_mul(face, gateway_fee_bps)
        }
    // Same period AND gross accumulation stays within cap.
    | current_time < current_period_start + period_length_seconds
        and (face + bps_mul(face, gateway_fee_bps)) <= max_amount_per_period - current_period_total =>
        effect {
          current_period_total += face + bps_mul(face, gateway_fee_bps)
          pulled_amount        := face + bps_mul(face, gateway_fee_bps)
          payment_amount       := face
          total_fee            := bps_mul(face, gateway_fee_bps)
          protocol_cut         := bps_mul(total_fee, protocol_share_bps)
          scheduler_cut        := bps_mul(total_fee, scheduler_share_bps)
          referral_pool        := if is_referral_enabled == 1 then bps_mul(total_fee, referral_allocation_bps) else 0
          gateway_residual     := total_fee - protocol_cut - scheduler_cut - referral_pool
          recipient_amount     := payment_amount
          total_from_user      := face + bps_mul(face, gateway_fee_bps)
        }
    // Any accepted face whose gross pull would breach the per-period cap
    // is rejected (caps bind on gross — ADR-0026).
    | _ => abort InsufficientDelegatedAmount
}

// ── transfer (standalone, ADR-0004) ─────────────────────────────────
// Pure token movement — does NOT route through calculate_fees, so it must
// not touch any fee field (else fee_conservation would break). Only the
// pull accumulator moves; pull_bounded is PAYG-specific so transfer is
// excluded from it (see property scope).
handler transfer (amount : U64) : State -> State {
  permissionless
  requires emergency_pause == 0 else ProgramPaused
  requires policy_status == 0 else PolicyPaused
  requires amount > 0 else InvalidAmount
  effect {
    pulled_amount := amount
  }
}

// ── Milestone access control (signer-bit authorization) ─────────────
// Models validate_policy_execution — Milestone branch: bits 1-3 are
// mutually exclusive; the set bit must match the corresponding caller
// identity. Captured as guard requires on a dedicated release handler.
handler release_milestone (current_time : U64) (due_timestamp : U64) : State -> State {
  permissionless
  requires emergency_pause == 0 else ProgramPaused
  requires policy_status == 0 else PolicyPaused
  // bit0 RELEASE_DUE_DATE — if set, due timestamp must have passed.
  requires release_due_date == 0 or current_time >= due_timestamp
    else PaymentNotDue
  // bit1 RELEASE_GATEWAY — if set, caller must be the gateway signer.
  requires release_requires_gateway == 0 or caller_is_gateway == 1
    else Unauthorized
  // bit2 RELEASE_OWNER — if set, caller must be the owner.
  requires release_requires_owner == 0 or caller_is_owner == 1
    else Unauthorized
  // bit3 RELEASE_RECIPIENT — if set, caller must be the recipient.
  requires release_requires_recipient == 0 or caller_is_recipient == 1
    else Unauthorized
  requires is_net_mode == 0
  effect {
    pulled_amount    := payment_amount
    total_fee        := bps_mul(payment_amount, gateway_fee_bps)
    protocol_cut     := bps_mul(total_fee, protocol_share_bps)
    scheduler_cut    := bps_mul(total_fee, scheduler_share_bps)
    referral_pool    := if is_referral_enabled == 1 then bps_mul(total_fee, referral_allocation_bps) else 0
    gateway_residual := total_fee - protocol_cut - scheduler_cut - referral_pool
    recipient_amount := payment_amount - total_fee
    total_from_user  := payment_amount
  }
}

// ════════════════════════════════════════════════════════════════════
// PROPERTIES (the headline correctness claims)
// ════════════════════════════════════════════════════════════════════

// A2 — PAYG cross-period drain-resistance: no chunk sequence, across
// period resets, extracts more than `max_amount_per_period` per period.
// Preserved by every handler except create_payment_policy (which
// establishes it from a zero period total). transfer / release_milestone
// don't touch period fields, so they preserve trivially.
property period_bounded :
  state.current_period_total <= state.max_amount_per_period
  preserved_by all except [create_payment_policy]

// The per-period cap is immutable after creation (no handler widens it).
// create_payment_policy is the only writer, so it is excluded.
property period_cap_fixed :
  state.max_amount_per_period == old(state.max_amount_per_period)
  preserved_by all except [create_payment_policy]

// Fee conservation (ADR-0018): the four carve-outs sum exactly to
// total_fee; gateway_residual is the balancing item, so the equality is
// structural (linear — auto-discharges). transfer doesn't touch fee
// fields so it preserves trivially.
property fee_conservation :
  (state.protocol_cut + state.scheduler_cut + state.referral_pool + state.gateway_residual) == state.total_fee
  preserved_by all except [create_payment_policy]

// total_fee is exactly the bps decomposition of the payment amount.
// Nonlinear (mul/div) — the Lean + Kani discharge targets.
property fee_is_bps_decomposition :
  state.total_fee == bps_mul(state.payment_amount, state.gateway_fee_bps)
  preserved_by all except [create_payment_policy, transfer]

// Gross-mode recipient receives payment minus the full fee (no hidden tax).
// Scoped to gross mode via `requires is_net_mode == 0` on execute handlers;
// net mode satisfies recipient_amount == payment_amount (different identity,
// not claimed here). Nonlinear via total_fee — Lean + Kani discharge targets.
property recipient_net_of_fee :
  (state.recipient_amount + state.total_fee) == state.payment_amount
  preserved_by all except [create_payment_policy, transfer]

// Pull bound (PAYG-specific): the chunk moved never exceeds max_chunk_amount.
// transfer and release_milestone pull amounts governed by different bounds
// (transfer: caller amount; milestone: escrow), so they are excluded.
property pull_bounded :
  state.pulled_amount <= state.max_chunk_amount
  preserved_by all except [create_payment_policy, transfer, release_milestone]

// Residual is non-negative (guaranteed by checked_sub construction; the
// property makes the invariant explicit and guards against a future
// re-ordering of the subtraction).
property residual_nonnegative :
  state.gateway_residual <= state.total_fee
  preserved_by all except [create_payment_policy, transfer]

// ── Composable-specific properties (Layer 1 spec-model; Layer 2 covers
// the real code via hand-rolled Kani/proptest — see kani_pure_fns.rs and
// proptest_pure_fns.rs). ────────────────────────────────────────────

// Referral pool is carved from total_fee (pool = fee × allocation_bps /
// 10000), so it can never exceed the total fee. Conservation: the pool
// is a SUBSET of the fee, not an addition to it.
property referral_pool_bounded :
  state.referral_pool <= state.total_fee
  preserved_by all except [create_payment_policy, transfer]

// Sweep non-negativity (composable settlement, ADR-0010 amended):
// after fee deduction, the recipient receives a non-negative amount.
// recipient_amount = payment_amount - total_fee ≥ 0, enforced by the
// checked_sub in calculate_fees. v2.1: min_output_amount was removed;
// post_validation (Lighthouse assertion) generalizes the output floor.
// This property models the structural invariant (fee ≤ payment), not
// the owner-set floor (which is an assertion, not a state predicate).
// v2.2 (ADR-0026): for execute_composable, recipient_amount = face (not
// face - fee), because fees are now SKIMMED before settlement, not
// subtracted from recipient_amount. PaymentPolicy still subtracts.
property sweep_nonnegative :
  state.recipient_amount <= state.payment_amount
  preserved_by all except [create_payment_policy, transfer]

// ── Composable v2.2 properties (ADR-0026) ───────────────────────────
// Headline guarantees of the input-side gross-pull fee rebase.

// Fee basis is FACE, not gross pull. total_fee == bps_mul(face, bps) where
// face is the amount the forward consumes (== payment_amount in the
// execute_composable effect). The PULL is gross (face + fee); the FEE is
// computed on face alone. This is the NET-on-pull-hardcoded invariant.
// Nonlinear via bps_mul — Lean + Kani discharge targets. Exclusive to
// execute_composable (PaymentPolicy still gates on is_net_mode).
property composable_fee_basis_is_face :
  state.total_fee == bps_mul(state.payment_amount, state.gateway_fee_bps)
  preserved_by [execute_composable]

// Gross-pull accounting: the user pays face + fee. total_from_user tracks
// the gross pull (what left the user's token account). Linear identity over
// the effect — auto-discharges.
property composable_gross_pull_matches_face_plus_fee :
  state.total_from_user == state.payment_amount + state.total_fee
  preserved_by [execute_composable]

// PayAsYouGo period accumulator binds on GROSS for composable (ADR-0026):
// the rolling period total reflects gross pulls, not face amounts. A fee-bps
// hike can fail a subsequent execute at the cap (accepted consequence).
// This STRENGTHENS period_bounded for composable — caps now bind tighter.
// Linear conservation: current_period_total accumulates `face + total_fee`
// per call, never `face` alone.
property composable_period_accumulates_gross :
  state.current_period_total <= state.max_amount_per_period
  preserved_by [execute_composable]

// ════════════════════════════════════════════════════════════════════
// INVARIANTS (documentation + Lean predicate obligations)
// ════════════════════════════════════════════════════════════════════

invariant fee_share_sum_bounded :
  (state.protocol_share_bps + state.scheduler_share_bps + state.referral_allocation_bps) <= BPS_DENOMINATOR

// Milestone signer bits 1-3 are mutually exclusive — enforced at policy
// creation (policies/milestone.rs::validate_milestone_policy), not by any
// in-scope handler. The release_milestone requires clauses rely on this:
// the code uses an else-if chain (first-set-wins), so at most one bit fires.
invariant milestone_signer_bits_mutually_exclusive :
  (state.release_requires_gateway + state.release_requires_owner + state.release_requires_recipient) <= 1

// Documentation-only invariants (kept as comments, not `invariant` blocks,
// to avoid vacuous `theorem : True := trivial` codegen). These are real
// guarantees but are enforced by per-handler `requires` guards and by the
// integration-test surface, not by a state predicate:
//
//   no_drain_when_paused  : execute_payment / execute_composable reject
//                           when emergency_pause != 0 or policy_status != 0
//                           (see the `requires` guards on each handler).
//   cpi_boundary_documented : signer sanitization (ADR-0008), the forward
//                           allowlist (Meteora DLMM), and the validation
//                           allowlist (Lighthouse) are enforced on-chain
//                           and verified by integration tests + fuzzing,
//                           not by a state predicate in this spec.
//
// ── Composable v2.2 (ADR-0026) documentation invariants ─────────────
// Account-wiring and mode-conditional rules — real guarantees but live in
// the execute handler's account-resolution path, not in the state struct.
// Integration-tested in tests/composable-fee-rebase.test.ts and
// tests/topup-balance-swap.test.ts:
//
//   composable_fee_input_side_only : fees are skimmed from intermediate_input
//                                    in input_mint BEFORE the forward runs.
//                                    gateway_fee_account and protocol_fee_account
//                                    are constrained to input_mint at the
//                                    Anchor accounts-struct level — passing
//                                    an output_mint ATA fails (TokenMintMismatch,
//                                    integration-tested).
//
//   act_mode_residual_to_user      : in deliver-transform and act modes, any
//                                    under-consumed input residue returns to
//                                    the USER (never the recipient, never fee
//                                    accounts). The sweep_input_residual_to_user
//                                    helper is the sole writer; asset separation
//                                    is structural.
//
//   deliver_transform_sweeps_output : the forward's output (intermediate_output
//                                    balance) always sweeps to the recipient
//                                    in deliver-transform mode. The >0 guard
//                                    is KEPT in this mode (ForwardProducedNoOutput).
//
//   act_mode_skips_output_guard    : in act mode (output_mint == sentinel),
//                                    no intermediate_output ATA is created,
//                                    no deliver sweep runs, and the >0 output
//                                    guard is SKIPPED. The owner's
//                                    post_validation is the only settlement
//                                    floor.
//
//   settlement_shapes_disjoint     : the three shapes (deliver-no-transform,
//                                    deliver-transform, act) are disjoint and
//                                    exhaustive over (forward_enabled,
//                                    output_mint == sentinel). No policy
//                                    matches two shapes; every policy matches
//                                    exactly one. Enforced at create via
//                                    validate_forward_config.
//
//   create_rejects_disabled_forward_with_mismatched_output : forward disabled
//                                    AND output_mint != input_mint is rejected
//                                    at create (ForwardDisabledRequiresSameMint).
//                                    Integration-tested.
