{
  "name": "@tributary-so/payments",
  "version": "1.9.1",
  "description": "Payments SDK for Tributary USDC subscriptions - zero API keys required",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --testPathIgnorePatterns='verification.e2e.test.ts'",
    "test:e2e": "npx tsx --test src/core/verification.e2e.test.ts",
    "lint": "exit 0",
    "prepack": "pnpm run build",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@tributary-so/sdk": "workspace:*",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
