{
  "name": "@tributary-so/payments",
  "version": "1.0.0",
  "description": "Payments SDK for Tributary USDC subscriptions - zero API keys required",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
