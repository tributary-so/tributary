{
  "name": "@tributary-so/pools-client",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "license": "MIT",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Pure-fetch client for the Tributary /v1/pools/search endpoint (pool resolver service). No React, no globals.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf ./dist",
    "prepack": "pnpm run build",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.59.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main"
    ]
  }
}
