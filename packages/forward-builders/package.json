{
  "name": "@tributary-so/forward-builders",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "license": "MIT",
  "version": "1.2.1",
  "type": "module",
  "description": "Concrete ForwardBuilder implementations for Tributary composable execution (ADR-0030).",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "clean": "rm -rf ./dist",
    "build": "npx tsup",
    "prepack": "pnpm run build",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@tributary-so/sdk": "workspace:*",
    "bn.js": "^5.2.2"
  },
  "peerDependencies": {
    "@meteora-ag/dlmm": "^1.0.0",
    "@orca-so/whirlpools": "^8.0.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.59-alpha",
    "@solana/kit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@meteora-ag/dlmm": {
      "optional": true
    },
    "@orca-so/whirlpools": {
      "optional": true
    },
    "@raydium-io/raydium-sdk-v2": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@meteora-ag/dlmm": "^1.0.0",
    "@orca-so/whirlpools": "^8.0.1",
    "@raydium-io/raydium-sdk-v2": "^0.2.59-alpha",
    "@solana/kit": "^3.0.3",
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^29.0.3",
    "@types/node": "^22.10.6",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.0.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist/**/*"
  ],
  "main": "./dist/packages/forward-builders/src/index.js",
  "types": "./dist/packages/forward-builders/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/forward-builders/src/index.d.ts",
      "default": "./dist/packages/forward-builders/src/index.js"
    },
    "./config": {
      "types": "./dist/packages/forward-builders/src/config.d.ts",
      "default": "./dist/packages/forward-builders/src/config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.6.0",
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
