{
  "name": "@tributary-so/sdk-x402",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "version": "1.5.0",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/metering.test.ts",
    "lint": "exit 0",
    "ci": "npm run build && npm run lint && npm run format:check",
    "server": "npx tsx src/server.ts",
    "client": "npx tsx src/client.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "description": "x402 integration for tributary subscriptions on solana",
  "keywords": [
    "solana-web3js",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@tributary-so/sdk": "workspace:*",
    "bn.js": "^5.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.2.0",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.5.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=16"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
        {
          "releaseRules": {
            "major": [
              ":boom:",
              "💥"
            ],
