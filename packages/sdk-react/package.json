{
  "name": "@tributary-so/sdk-react",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "license": "MIT",
  "version": "1.7.0-beta.1",
  "type": "module",
  "description": "React hooks and utilities for Tributary recurring payments",
  "scripts": {
    "lint": "exit 0",
    "test": "exit 0",
    "clean": "rm -rf ./dist",
    "build": "pnpm run clean && tsup",
    "prepack": "pnpm run build",
    "dev": "vite",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "dependencies": {
    "@actioncodes/sdk": "^2.0.18",
    "@heroui/button": "^2.2.29",
    "@heroui/input": "^2.4.30",
    "@heroui/popover": "^2.3.29",
    "@heroui/react": "^2.8.7",
    "@heroui/system": "^2.4.25",
    "@heroui/theme": "^2.4.25",
    "@tributary-so/payments": "workspace:*",
    "@tributary-so/sdk": "workspace:*",
    "lucide-react": "^0.544.0"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.0.0",
    "postcss": "^8.4.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.24.0"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/web3.js": "^1.98.4",
    "react": "^19.2.0"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.6.0",
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
        {
