{
  "name": "@tributary-so/ui",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tributary UI kit \u2014 unified design tokens, layout chrome, Solana infra and domain components",
  "scripts": {
    "build": "pnpm run clean && tsup",
    "clean": "rm -rf ./dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "exit 0",
    "prepack": "pnpm run build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js"
    },
    "./tributary": {
      "types": "./dist/tributary/index.d.ts",
      "import": "./dist/tributary/index.js"
    },
    "./styles/fonts": {
      "types": "./src/styles/fonts.d.ts",
      "default": "./src/styles/fonts.css"
    },
    "./styles": "./src/styles/tokens.css",
    "./styles/heroui": "./dist/styles/theme-heroui.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "src/fonts"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "@heroui/react": ">=2.8.10",
    "@solana/wallet-adapter-phantom": ">=0.9.28",
    "@solana/wallet-adapter-react": ">=0.15.35",
    "@solana/wallet-adapter-react-ui": ">=0.9.35",
    "@solana/wallet-adapter-solflare": ">=0.6.32",
    "@solana/web3.js": ">=1.98.0",
    "@tanstack/react-query": ">=5.89.0",
    "@tributary-so/payments": "workspace:*",
    "@tributary-so/sdk": "workspace:*",
    "@tributary-so/tokens-client": "workspace:*",
    "dfts-qrcode": ">=1.1.0",
    "jotai": ">=2.14.0",
    "lucide-react": ">=0.544.0",
    "next-themes": ">=0.4.6",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-router": ">=7.0.0",
    "shiki": ">=4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "storybook": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.35.0",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.6",
    "@eslint/js": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.44.0"
  }
}