{
  "name": "@tributary-so/sdk",
  "repository": {
    "url": "https://github.com/tributary-so/tributary",
    "type": "git"
  },
  "license": "MIT",
  "private": false,
  "version": "1.11.1",
  "type": "module",
  "scripts": {
    "lint": "exit 0",
    "test": "npx tsx --test src/__tests__/**/*.test.ts",
    "clean": "rm -rf ./dist",
    "build": "npx tsup",
    "manager": "npx tsx src/manager.ts",
    "prepack": "pnpm run build",
    "docs": "typedoc",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@rollup/plugin-inject": "^5.0.5",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "lighthouse-sdk-legacy": "workspace:*"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.10.6",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^10.0.0",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "typedoc": "^0.28.14",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=16"
  },
  "main": "./dist/packages/sdk/src/index.js",
  "types": "./dist/packages/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/packages/sdk/src/index.d.ts",
      "default": "./dist/packages/sdk/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.6.0",
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
        {
          "releaseRules": {
            "major": [
              ":boom:",
              "💥"
            ],
            "minor": [
              ":sparkles:",
              ":children_crossing:",
              ":lipstick:",
              ":art:",
              ":zap:",
              ":globe_with_meridians:",
