              ":lock:",
              ":pushpin:",
              ":arrow_down:",
              ":arrow_up:",
              ":rewind:",
              ":rotating_light:",
              ":green_heart:",
              ":white_check_mark:",
              ":memo:",
              ":heavy_minus_sign:",
              ":wrench:",
              ":hammer:",
              ":rewind:",
              ":alien:",
              ":see_no_evil:",
              ":construction:",
              ":green_heart:",
              ":adhesive_bandage:",
              ":pencil2:",
              ":poop:",
              ":coffin:",
              ":test_tube:",
              ":necktie:",
              ":goal_net:",
              ":dizzy:",
              ":wastebasket:",
              "🐛",
