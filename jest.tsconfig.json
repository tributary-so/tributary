{
  "compilerOptions": {
    "module": "es2020",
    "target": "es2020",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "lib": [
      "es2020"
    ],
    "types": [
      "node",
      "jest"
    ],
    "isolatedModules": true
  }
}
