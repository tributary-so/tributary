# Surfpool (local mainnet-fork) — the demo's default cluster.
# Start it with:
#   surfpool start --legacy-anchor-compatibility --no-tui
VITE_SOLANA_API_SURFPOOL=http://localhost:8000

# Optional mainnet / devnet overrides for the cluster switcher.
VITE_SOLANA_API=https://api.mainnet-beta.solana.com
VITE_SOLANA_API_DEVNET=https://api.devnet.solana.com
