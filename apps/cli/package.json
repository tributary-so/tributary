{
  "name": "@tributary-so/cli",
  "private": false,
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/src/index.js",
    "ci": "bun run build && bun run lint && bun run format:check",
    "dev": "bun run src/index.tsx",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "exit 0;",
    "lint2": "eslint ."
  },
  "files": [
    "dist/src",
    "tributary.cjs"
  ],
  "description": "Keeper to run payments",
  "keywords": [
    "solana-web3js",
    "typescript"
  ],
  "version": "1.0.1",
  "type": "module",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@opentui/core": "^0.1.0",
    "@opentui/react": "^0.1.0",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "@tributary-so/sdk": "workspace:*",
    "bn.js": "^5.2.1",
    "react": "^19.0.0",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.5.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^2.6.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0"
  },
  "main": "./dist/src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "tributary": "./tributary.cjs",
    "@tributary-so/cli": "./tributary.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
