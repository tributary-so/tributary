{
  "name": "@tributary-so/cli",
  "private": false,
  "description": "Tributary command line tool",
  "version": "1.8.0",
  "author": "Fabian Schuh",
  "bin": {
    "cli": "./bin/run.js",
    "tributary": "./bin/run.js",
    "@tributary-so/cli": "./bin/run.js"
  },
  "bugs": "https://github.com/tributary-so/tributary/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "@tributary-so/sdk": "workspace:*",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/tributary-so/tributary",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "cli",
    "dirname": "cli",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "wallet": {
        "description": "Wallet management - keypair creation, import, and balance queries"
      },
      "program": {
        "description": "Protocol configuration - program initialization and config queries"
      },
      "user": {
        "description": "User Payment accounts - create, list, and inspect user payment state"
      },
      "gateway": {
        "description": "Payment gateway management - create, configure, and inspect gateways"
      },
      "subscription": {
        "description": "Subscription payment policies - create, list, pause, resume, and delete"
      },
      "payments": {
        "description": "Payment execution - trigger recurring payment processing"
      },
      "referral": {
        "description": "Referral system - create referral accounts and query referral chains"
      },
      "pda": {
        "description": "PDA utilities - derive program addresses for all account types"
      }
    }
  },
  "repository": "tributary-so/tributary",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "types": "dist/index.d.ts",
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
        {
          "releaseRules": {
            "major": [
              ":boom:",
              "💥"
            ],
            "minor": [
