{
  "name": "@tributary-so/cli",
  "private": false,
  "scripts": {
    "build": "tsup",
    "ci": "pnpm run build && pnpm run lint && pnpm run format:check",
    "dev": "node --loader ts-node/esm src/index.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "exit 0;",
    "lint2": "eslint .",
    "release": "semantic-release -e semantic-release-monorepo"
  },
  "files": [
    "lib"
  ],
  "description": "Keeper to run payments",
  "keywords": [
    "solana-web3js",
    "typescript"
  ],
  "version": "1.8.0",
  "type": "module",
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "@tributary-so/sdk": "workspace:*",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.5.2",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^2.6.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0"
  },
  "main": "./lib/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "tributary": "./lib/index.js",
    "@tributary-so/cli": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "semantic-release-gitmoji",
        {
          "releaseRules": {
            "major": [
              ":boom:",
              "💥"
            ],
            "minor": [
