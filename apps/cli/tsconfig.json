{
  "compilerOptions": {
    "types": ["node", "jest"], // Make sure jest is included only once
    "skipLibCheck": true, // Temporarily bypass library type checking
    "declaration": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "es2022",
    "moduleResolution": "node16"
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
