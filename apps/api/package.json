{
  "name": "@tributary-so/api",
  "private": false,
  "version": "1.0.0",
  "description": "Tributary API - Modular Express API for subscription and payment services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npx tsx src/index.ts",
    "db:test": "npx tsx src/test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@tributary-so/payments": "workspace:*",
    "@tributary-so/sdk": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.7.4",
    "typescript": "^5.3.3"
  }
}
