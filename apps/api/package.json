{
  "name": "@tributary-so/api",
  "private": false,
  "version": "1.0.0",
  "description": "Tributary API - Modular Express API for subscription and payment services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npx tsx src/index.ts",
