{
  "name": "@tributary-so/api",
  "private": false,
  "version": "2.2.2",
  "description": "Tributary API - Modular Express API for subscription and payment services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathIgnorePatterns=xxx --testPathPattern=e2e",
    "test:integration": "jest --testPathIgnorePatterns=xxx --testPathPattern=integration",
    "db:test": "npx tsx src/test-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "release": "semantic-release"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@tributary-so/payments": "workspace:*",
    "@tributary-so/sdk": "workspace:*",
    "@tributary-so/tokens-client": "workspace:*",
    "bn.js": "^5.2.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "jose": "^6.2.2",
    "js-yaml": "^4.1.0",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.8",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.0",
    "tsx": "^4.7.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.44.0"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "main"
    ],
