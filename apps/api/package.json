    "@tributary-so/sdk": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "jose": "^6.2.2",
    "kafkajs": "^2.2.4",
    "postgres": "^3.4.8",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
