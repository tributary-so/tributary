# Environment Variables

# Database connection (PostgreSQL - read-only)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

ADMIN_API_KEY=9b21a8ad-68bf-40f6-b563-0ef5e56dc493

# JWT signing key encryption (hex-encoded 32-byte key for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_KEY_ENCRYPTION_KEY=

# Key rotation interval in days (default: 30)
KEY_ROTATION_DAYS=30

# JWT configuration
JWT_ISSUER=https://api.tributary.so
JWT_AUDIENCE=tributary-checkout

# tokens.xyz asset catalog proxy (ADR-0028). Server-side only — never
# expose TOKENS_XYZ_API_KEY to the browser. Unset → /v1/assets/* returns
# empty results (search) / fallback map (resolve).
TOKENS_XYZ_API_KEY=
TOKENS_XYZ_BASE_URL=https://api.tokens.xyz/v1
