spec Tributary

program_id "TRibg8W8zmPHQqWtyAD1rEBRXEdyU13Mu6qX1Sg42tJ"

// ─── Constants ────────────────────────────────────────────────────────────────

const BPS_SCALE = 10000
const DEFAULT_PROTOCOL_FEE_BPS = 100
const MAX_GATEWAY_FEE_BPS = 10000
const MAX_MILESTONES = 4

// ─── Error type ───────────────────────────────────────────────────────────────

type Error
  | ProgramPaused
  | InvalidAmount
  | InvalidFrequency
  | MaxPoliciesReached
  | Unauthorized
  | InvalidPolicyStatusTransition
  | PolicyNotFound
  | InsufficientDelegatedAmount
  | PaymentNotDue
  | InsufficientBalance
  | NoDelegateSet
  | PolicyPaused
  | InvalidInterval
  | InvalidFeeBps
  | ArithmeticOverflow
  | MathOverflow

// ─── PDA declarations ─────────────────────────────────────────────────────────

pda program_config ["config"]
pda user_payment ["user_payment", owner, mint]
pda payment_gateway ["gateway", authority]
pda payment_policy ["payment_policy", user_payment, policy_id_bytes]
pda payments_delegate ["payments"]

// ─── State types ──────────────────────────────────────────────────────────────

type ProgramConfig = {
  admin            : Pubkey,
  fee_recipient    : Pubkey,
  protocol_fee_bps : U16,
  emergency_pause  : U8,
  bump             : U8,
}

type PaymentGateway = {
  authority              : Pubkey,
  fee_recipient          : Pubkey,
  gateway_fee_bps        : U16,
  is_active              : U8,
  signer                 : Pubkey,
  feature_flags          : U8,
  referral_allocation_bps: U16,
  custom_protocol_fee_bps: U16,
  bump                   : U8,
}

type PaymentFrequency
  | Daily
  | Weekly
  | Monthly
  | Quarterly
  | SemiAnnually
  | Annually
  | Custom of { interval_seconds : U64 }

type PolicyType
  | Subscription of {
      amount            : U64,
      auto_renew        : U8,
      max_renewals      : U64,
      payment_frequency : PaymentFrequency,
      next_payment_due  : I64,
    }
  | Milestone of {
      milestone_amounts   : Map[MAX_MILESTONES] U64,
      milestone_timestamps: Map[MAX_MILESTONES] I64,
      current_milestone   : U8,
      release_condition   : U8,
      total_milestones    : U8,
      escrow_amount       : U64,
    }
  | PayAsYouGo of {
      max_amount_per_period : U64,
      max_chunk_amount      : U64,
      period_length_seconds : U64,
      current_period_start  : I64,
      current_period_total  : U64,
    }

type PaymentStatus
  | Active
  | Paused

type PaymentPolicy = {
  user_payment  : Pubkey,
  recipient     : Pubkey,
  gateway       : Pubkey,
  policy_type   : PolicyType,
  status        : PaymentStatus,
  total_paid    : U64,
  payment_count : U32,
  created_at    : I64,
  updated_at    : I64,
  policy_id     : U32,
  bump          : U8,
}

type UserPayment = {
  owner                  : Pubkey,
  token_account          : Pubkey,
  token_mint             : Pubkey,
  active_policies_count  : U32,
  created_policies_count : U32,
  created_at             : I64,
  updated_at             : I64,
  is_active              : U8,
  bump                   : U8,
}

// ─── Events ───────────────────────────────────────────────────────────────────

event ProgramConfigCreated { admin : Pubkey, fee_recipient : Pubkey, protocol_fee_bps : U16 }
event UserPaymentCreated { owner : Pubkey, token_account : Pubkey, token_mint : Pubkey }
event PaymentGatewayCreated { authority : Pubkey, fee_recipient : Pubkey, gateway_fee_bps : U16 }
event PaymentPolicyCreated { user_payment : Pubkey, recipient : Pubkey, gateway : Pubkey, policy_id : U32 }
event PaymentRecord { payment_policy : Pubkey, gateway : Pubkey, amount : U64, timestamp : I64, payer : Pubkey, recipient : Pubkey, token_mint : Pubkey }
event PaymentPolicyStatusChanged { payment_policy : Pubkey }
event PaymentPolicyDeleted { payment_policy : Pubkey, owner : Pubkey, policy_id : U32 }

// ─── Handlers: core payment flow ─────────────────────────────────────────────

/// One-time program initialization. Sets admin, fee_recipient, protocol_fee_bps.
handler initialize : State.Uninitialized -> State.Active {
  auth admin
  accounts {
    admin           : signer, writable
    config          : writable, pda ["config"]
    system_program  : program
  }

  effect {
    admin            := admin
    fee_recipient    := admin
    protocol_fee_bps := DEFAULT_PROTOCOL_FEE_BPS
    emergency_pause  := 0
  }

  emits ProgramConfigCreated
}

/// Create a user payment account scoped to owner+mint.
handler create_user_payment (owner : Pubkey) (token_account : Pubkey) (token_mint : Pubkey) {
  permissionless
  accounts {
    owner          : readonly
    user_payment   : writable, pda ["user_payment", owner, token_mint]
    token_account  : readonly
    token_mint     : readonly
    config         : readonly, pda ["config"]
    system_program : program
    fee_payer      : signer, writable
  }

  requires config.emergency_pause == 0 else ProgramPaused

  effect {
    owner                  := owner
    token_account          := token_account
    token_mint             := token_mint
    active_policies_count  := 0
    created_policies_count := 0
    is_active              := 1
  }

  emits UserPaymentCreated
}

/// Create a payment gateway. Admin-only. Validates gateway_fee_bps <= 10000.
handler create_payment_gateway (authority : Pubkey) (gateway_fee_bps : U16) {
  auth admin
  accounts {
    admin          : signer, writable
    authority      : readonly
    gateway        : writable, pda ["gateway", authority]
    config         : readonly, pda ["config"]
    fee_recipient  : readonly
    system_program : program
  }

  requires config.admin == admin else Unauthorized
  requires config.emergency_pause == 0 else ProgramPaused
  requires gateway_fee_bps <= MAX_GATEWAY_FEE_BPS else InvalidFeeBps

  effect {
    authority               := authority
    fee_recipient           := fee_recipient
    gateway_fee_bps         := gateway_fee_bps
    is_active               := 1
    signer                  := authority
    feature_flags           := 0
    referral_allocation_bps := 0
    custom_protocol_fee_bps := 0
  }

  emits PaymentGatewayCreated
}

/// Create a payment policy under a user payment account.
handler create_payment_policy (policy_type : PolicyType) {
  permissionless
  accounts {
    user           : readonly
    user_payment   : writable, pda ["user_payment", user, token_mint]
    recipient      : readonly
    token_mint     : readonly
    gateway        : readonly, pda ["gateway"]
    config         : readonly, pda ["config"]
    payment_policy : writable, pda ["payment_policy", user_payment, policy_id_bytes]
    system_program : program
    fee_payer      : signer, writable
  }

  requires config.emergency_pause == 0 else ProgramPaused
  requires gateway.is_active == 1 else PolicyPaused

  // Policy-type validation: conditional requires per variant
  requires
    (policy_type is .Subscription)
      implies (policy_type.Subscription.amount > 0)
  else InvalidAmount

  requires
    (policy_type is .Milestone)
      implies (
        policy_type.Milestone.total_milestones >= 1
        and policy_type.Milestone.total_milestones <= MAX_MILESTONES
        and policy_type.Milestone.current_milestone < policy_type.Milestone.total_milestones
        and policy_type.Milestone.escrow_amount > 0
      )
  else InvalidAmount

  requires
    (policy_type is .PayAsYouGo)
      implies (
        policy_type.PayAsYouGo.max_amount_per_period > 0
        and policy_type.PayAsYouGo.max_chunk_amount > 0
        and policy_type.PayAsYouGo.max_chunk_amount <= policy_type.PayAsYouGo.max_amount_per_period
        and policy_type.PayAsYouGo.period_length_seconds > 0
      )
  else InvalidInterval

  let policy_id = user_payment.created_policies_count + 1

  effect {
    user_payment.active_policies_count  += 1
    user_payment.created_policies_count := policy_id
    user_payment.updated_at             := now()
    payment_policy.user_payment         := user_payment
    payment_policy.recipient            := recipient
    payment_policy.gateway              := gateway
    payment_policy.policy_type          := policy_type
    payment_policy.status               := .Active
    payment_policy.total_paid           := 0
    payment_policy.payment_count        := 0
    payment_policy.created_at           := now()
    payment_policy.updated_at           := now()
    payment_policy.policy_id            := policy_id
  }

  emits PaymentPolicyCreated
}

/// Core payment execution handler.
/// Calculates fees, validates delegation and balance, transfers tokens.
handler execute_payment (payment_amount : U64) : State.Active -> State.Active {
  permissionless
  accounts {
    fee_payer              : signer
    payments_delegate      : readonly, pda ["payments"]
    payment_policy         : writable, pda ["payment_policy"]
    user_payment           : writable, pda ["user_payment"]
    gateway                : readonly, pda ["gateway"]
    config                 : readonly, pda ["config"]
    user_token_account     : writable
    mint                   : readonly
    recipient_token_account: writable
    gateway_fee_account    : writable
    protocol_fee_account   : writable
    token_program          : program
  }

  // ── Access control
  requires
    fee_payer == gateway.signer
    or fee_payer == user_payment.owner
    or fee_payer == payment_policy.recipient
  else Unauthorized

  // ── Global guards
  requires config.emergency_pause == 0 else ProgramPaused
  requires payment_policy.status is .Active else PolicyPaused
  requires gateway.is_active == 1 else PolicyPaused
  requires user_payment.is_active == 1 else ProgramPaused
  requires gateway.key == payment_policy.gateway else Unauthorized

  // ── Fee math (bounded by bps, checked arithmetic)
  let gateway_fee = payment_amount * gateway.gateway_fee_bps / BPS_SCALE
  let protocol_fee = payment_amount * config.protocol_fee_bps / BPS_SCALE
  let recipient_amount = payment_amount - gateway_fee - protocol_fee

  // ── Balance and delegation
  requires user_token_account.delegated_amount >= payment_amount else InsufficientDelegatedAmount
  requires user_token_account.amount >= payment_amount else InsufficientBalance

  // ── Recipient can only trigger PayAsYouGo
  requires
    not (fee_payer == payment_policy.recipient)
      or payment_policy.policy_type is .PayAsYouGo
  else Unauthorized

  // ── State updates
  effect {
    payment_policy.total_paid    += payment_amount
    payment_policy.payment_count += 1
    payment_policy.updated_at    := now()
    user_payment.updated_at      := now()
  }

  // ── Transfers
  transfers {
    from user_token_account to recipient_token_account amount recipient_amount authority payments_delegate
    from user_token_account to gateway_fee_account amount gateway_fee authority payments_delegate
    from user_token_account to protocol_fee_account amount protocol_fee authority payments_delegate
  }

  emits PaymentRecord
}

/// Toggle payment policy between Active and Paused. Owner-only.
handler change_payment_policy_status (policy_id : U64) (new_status : PaymentStatus) {
  auth owner
  accounts {
    owner          : signer, writable
    user_payment   : writable, pda ["user_payment", owner, token_mint]
    token_mint     : readonly
    payment_policy : writable, pda ["payment_policy", user_payment, policy_id_bytes]
    config         : readonly, pda ["config"]
  }

  requires config.emergency_pause == 0 else ProgramPaused
  requires user_payment.owner == owner else Unauthorized

  // Only Active <-> Paused transitions allowed
  requires
    (payment_policy.status is .Active and new_status is .Paused)
    or (payment_policy.status is .Paused and new_status is .Active)
  else InvalidPolicyStatusTransition

  effect {
    payment_policy.status    := new_status
    payment_policy.updated_at := now()
    user_payment.updated_at  := now()
  }

  emits PaymentPolicyStatusChanged
}

/// Delete a payment policy. Owner-only. Decrements active_policies_count.
handler delete_payment_policy (policy_id : U64) {
  auth owner
  accounts {
    owner          : signer, writable
    user_payment   : writable, pda ["user_payment", owner, token_mint]
    token_mint     : readonly
    payment_policy : writable, pda ["payment_policy", user_payment, policy_id_bytes]
    config         : readonly, pda ["config"]
  }

  requires config.emergency_pause == 0 else ProgramPaused
  requires user_payment.owner == owner else Unauthorized

  effect {
    user_payment.active_policies_count -=! 1
    user_payment.updated_at            := now()
  }

  emits PaymentPolicyDeleted
}

// ─── Properties ───────────────────────────────────────────────────────────────

/// Protocol fee bps is always bounded
invariant protocol_fee_bounded :
  config.protocol_fee_bps <= MAX_GATEWAY_FEE_BPS

/// Gateway fee bps is always bounded
invariant gateway_fee_bounded :
  gateway.gateway_fee_bps <= MAX_GATEWAY_FEE_BPS

/// Total paid never decreases
property total_paid_monotone :
  payment_policy.total_paid >= 0
  preserved_by [execute_payment]

/// Cover: happy subscription path
cover subscription_happy [initialize, create_user_payment, create_payment_gateway, create_payment_policy, execute_payment]

/// Cover: pause and unpause
cover pause_unpause [initialize, create_user_payment, create_payment_gateway, create_payment_policy, change_payment_policy_status, change_payment_policy_status]

/// Cover: delete policy
cover delete_happy [initialize, create_user_payment, create_payment_gateway, create_payment_policy, delete_payment_policy]
